# Summaries use Groq first (openai/gpt-oss-20b, then 120b), then OpenAI.
# Llama 3 models on Groq are enterprise-only; developer keys need gpt-oss.
# Whisper audio is only used when a video has no captions (OpenAI first, then Groq).
OPENAI_API_KEY=
GROQ_API_KEY=
